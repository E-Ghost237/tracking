# Production-safe defaults. Copy to .env and fill in every secret from your secrets manager.
# Never commit a populated .env (section 14.3).
APP_NAME=Corvane
APP_ENV=production
# Must stay false in production: debug mode exposes stack traces and configuration.
APP_DEBUG=false
APP_KEY=
APP_URL=https://www.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Separate 32-byte key for AES-256-GCM field encryption (payment details, gift cards, 2FA seeds,
# carrier credentials). Generate with: echo "base64:$(openssl rand -base64 32)"
# Rotating it requires re-encrypting the affected columns.
FIELD_ENCRYPTION_KEY=

# Comma-separated list of proxy/CDN addresses allowed to set X-Forwarded-* headers.
# Leave empty unless the app sits behind a known proxy; "*" only when the app is unreachable directly.
TRUSTED_PROXIES=

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=365

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=corvane
DB_USERNAME=corvane
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SECURITY_HSTS=true
GLOBAL_RATE_PER_MINUTE=240

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# private (local disk) or private_s3 (S3-compatible bucket with public access blocked)
PRIVATE_DISK=private_s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Back-office path and optional comma-separated IP allowlist (FR-149).
ADMIN_PATH=admin
ADMIN_IP_ALLOWLIST=
SANCTUM_STATEFUL_DOMAINS=www.example.com

BRAND_NAME=Corvane
BRAND_LEGAL_NAME="Corvane Logistics"
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_SUPPORT_PHONE=
BRAND_WHATSAPP=
BRAND_DATA_CONTACT=privacy@example.com
BRAND_ADDRESS=

# CAPTCHA: turnstile in production (builtin is a fallback, none only for tests).
CAPTCHA_DRIVER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tracking aggregator: null (staff-entered events only) or aftership.
TRACKING_PROVIDER=null
AFTERSHIP_API_KEY=
TRACKING_WEBHOOK_SECRET=

# Geocoding: local (seeded cities), mapbox or opencage. Keys stay server-side.
GEOCODER=local
MAPBOX_TOKEN=
OPENCAGE_KEY=

# Upload scanning: clamav in production, heuristic as fallback.
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
